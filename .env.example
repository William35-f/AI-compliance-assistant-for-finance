# Copy this file to .env and fill in the values. Never commit .env.
# Both docker-compose and the backend read .env from the repo root.

# --- Postgres (docker-compose uses these to create the database) ---
POSTGRES_USER=regulens
POSTGRES_PASSWORD=regulens
POSTGRES_DB=regulens
# Host port. Change it if something else on your machine already uses 5432,
# and update DATABASE_URL below to match.
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql://regulens:regulens@localhost:5432/regulens

# --- LLM provider (used from Phase 2) ---
# One of: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
